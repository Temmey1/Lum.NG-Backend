# ═══════════════════════════════════════════════════════════
#  LUMNG Backend — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ─── Database (required) ─────────────────────────────────────────────────────
# Supabase:  postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Neon:      postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require
# Railway:   postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway
# Local:     postgresql://postgres:postgres@localhost:5432/lumng
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumng"

# ─── JWT (required) ──────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=5412cb897128637bd94911a2a120ad353c3393b6fc52ab511bceb6c8977cf62

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
APP_URL="http://localhost:5173"       # Frontend URL (used in recovery email links)

# ─── AI Shopping Assistant (Feature 1) ───────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Model used: gpt-4o-mini (cheapest capable model, ~$0.15 per 1M input tokens)
# The assistant ONLY activates when this key is set — safe to omit in dev.
OPENAI_API_KEY=""

# ─── Email / Abandoned Cart Recovery (Feature 2) ─────────────────────────────
# Powered by Resend — sign up free at https://resend.com
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=""

# Sender identity — domain must be verified in your Resend dashboard
# (or use onboarding@resend.dev for testing without domain verification)
FROM_EMAIL="lumngfabrics@gmail.com"
FROM_NAME="LUM NG Fabrics"

# Optional: shown in email footer
CONTACT_PHONE="+2349074112695"

# ─── Optional: Paystack Payment Gateway ──────────────────────────────────────
# PAYSTACK_SECRET_KEY=sk_live_xxxxx
# PAYSTACK_PUBLIC_KEY=pk_live_xxxxx

# ─── Optional: Cloudinary Image Storage ──────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── Optional: Twilio WhatsApp Notifications ─────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
